            "kind",
            "tradition",
            "is_global_taxonomy",
            "is_published_fatwa_corpus"
          ]
        }
      },
      "required": [
        "repository",
        "branch",
        "base_sha",
        "production_status",
        "gates",
        "pending_units",
        "historical_permissions",
        "permission_binding",
        "default_access",
        "draft_transitions",
        "domain_transaction_is_principal",
        "product_operations_enabled",
        "ai_enabled",
        "source_book"
      ]
