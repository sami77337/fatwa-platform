        "permission_binding": {
          "const": "NONE_CANDIDATE_BINDING_ONLY"
        },
        "default_access": {
          "const": "DENY_DEFAULT"
        },
        "draft_transitions": {
          "const": 58
        },
        "domain_transaction_is_principal": {
          "const": false
        },
        "product_operations_enabled": {
          "const": false
        },
        "ai_enabled": {
          "const": false
        },
        "source_book": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": 622
