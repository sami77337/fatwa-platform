  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "enum": [
            "_codex_input/FATWA_PINNED_ORIGINAL_PRODUCT_SPEC_TEXT_20261010.txt",
            "_codex_input/FATWA_PINNED_ORIGINAL_479_REQUIREMENTS_REGISTRY_20261010.jsonl",
            "AGENTS.md",
            "docs/coordination/PARALLEL_EXECUTION_20261013.md",
            "_codex_input/issue.md",
            "_codex_input/queued_issue_10.md",
            "docs/product/D072_RELEASE_DEFERRAL.md"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "LOCAL_PINNED_EXPORT",
            "REPOSITORY_MANDATE",
            "LOCAL_TASK_COPY",
            "LOCAL_DECISION_RECORD"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "revision",
        "kind"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "CLAUSE",
            "APPROVAL_MARKER",
            "REPOSITORY_MANDATE",
            "TASK_MANDATE"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "$ref": "#/$defs/id"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "text_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "clause": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "number": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "index_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 479
            }
          },
          "required": [
            "unit",
            "number",
            "index_line"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "source_id",
        "revision",
        "decision_id",
        "start_line",
        "end_line",
        "text_sha256"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "NOT_PASSED",
            "HOLD",
            "OWNER_APPROVAL_PENDING",
            "MISSING",
            "PENDING",
            "UNVERIFIED"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "status"
      ]
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "SAFE_DEV_ONLY",
            "DOCUMENTATION_ONLY",
            "BLOCKED",
            "DEFERRED",
            "OUT_OF_SCOPE"
          ]
        },
        "dependency_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "id",
        "label",
        "status",
        "dependency_ids"
      ]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "OWNER_APPROVED",
            "OWNER_APPROVAL_PENDING",
            "PROPOSED",
            "SUPERSEDED",
            "DEFERRED",
            "OUT_OF_SCOPE",
            "IMPLEMENTED_VERIFIED",
            "UNKNOWN"
          ]
        },
        "owner_approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "OWNER_APPROVED",
                "OWNER_APPROVAL_PENDING",
                "UNKNOWN"
              ]
            },
            "basis": {
              "type": "string",
              "enum": [
                "DOCUMENTARY_UNIT_RECORD",
                "PENDING_MANDATE",
                "REPOSITORY_DECISION_RECORD",
                "NOT_RECORDED"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "recorded_date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "basis",
            "evidence_ids",
            "recorded_date",
            "scope"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "security_sensitivity": {
          "type": "string",
          "enum": [
            "DOCUMENTATION",
            "PUBLIC_METADATA",
            "PRIVATE_CASE_DATA",
            "SCHOLARLY_AUTHORITY",
            "EXTERNAL_PROVIDER",
            "ACCESS_CONTROL"
          ]
        },
        "suggested_release_slice": {
          "$ref": "#/$defs/id"
        },
        "development_scope": {
          "type": "string",
          "enum": [
            "BLOCKED",
            "DOCUMENTATION_ONLY",
            "READ_ONLY_DEV",
            "DEFERRED",
            "PROHIBITED"
          ]
        },
        "activation": {
          "const": "DISABLED"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "NOT_EVALUATED",
                "NOT_IMPLEMENTED",
                "IMPLEMENTED_UNVERIFIED",
                "IMPLEMENTED_VERIFIED"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "required": [
            "status",
            "evidence_ids"
          ]
        },
        "test_status": {
          "type": "string",
          "enum": [
            "NOT_RUN",
            "FAIL",
            "PASS"
          ]
        },
        "owner_removal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "NOT_DECIDED",
                "REMOVAL_PENDING",
                "REMOVED"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "required": [
            "status",
            "evidence_ids"
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "source_evidence_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "NOT_RUN",
                  "FAIL",
                  "PASS"
                ]
              }
            },
            "required": [
              "id",
              "criterion",
              "source_evidence_ids",
              "status"
            ]
          }
        },
        "release_timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "DEFERRED_POST_FIRST_RELEASE"
            },
            "decision_id": {
              "const": "D-072"
            },
            "recorded_date": {
              "const": "2026-10-13"
            },
            "basis": {
              "const": "OWNER_DECISION_IN_QUEUED_ISSUE"
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "applies_to": {
              "const": "ALL_28_U10_CLAUSES"
            },
            "excluded_from_first_release": {
              "const": true
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "decision_id",
            "recorded_date",
            "basis",
            "evidence_ids",
            "applies_to",
            "excluded_from_first_release",
            "scope"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "classification",
        "owner_approval",
        "evidence_ids",
        "dependencies",
        "security_sensitivity",
        "suggested_release_slice",
        "development_scope",
        "activation",
        "implementation",
        "test_status",
        "owner_removal",
        "acceptance_criteria"
      ]
    }
  }
