{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S1 to S0 fiqh-toc.v1 normalized JSONL row",
  "description": "Development-only heading metadata; no fatwa answers, permissions or publication status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "reference_kind",
    "book_id",
    "dataset_id",
    "source_kind",
    "source_id",
    "parent_id",
    "title",
    "search_title",
    "sibling_order",
    "sequence",
    "depth",
    "part",
    "page",
    "source_part",
    "source_page",
    "edition",
    "provenance",
    "title_origin",
    "inference_evidence",
    "root_kind",
    "input_sha256",
    "input_record",
    "source_metadata"
  ],
  "properties": {
    "contract_version": {
      "const": "fiqh-toc.v1"
    },
    "reference_kind": {
      "const": "book_heading_index"
    },
    "book_id": {
      "const": "622"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_kind": {
      "enum": [
        "synthetic",
        "owner_supplied"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "parent_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "search_title": {
      "type": "string"
    },
    "sibling_order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "part": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "const": "المقدمة"
        }
      ]
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "source_part": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$",
          "maxLength": 18
        },
        {
          "const": "المقدمة"
        }
      ]
    },
    "source_page": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$",
          "maxLength": 18
        }
      ]
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title_origin": {
      "enum": [
        "direct",
        "inferred"
      ]
    },
    "inference_evidence": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "root_kind": {
      "enum": [
        "introduction",
        "fiqh_book",
        null
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_record": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "parent_id": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "depth": {
          "type": [
            "integer",
            "string"
          ]
        },
        "position_among_siblings": {
          "type": [
            "integer",
            "string"
          ]
        },
        "order": {
          "type": [
            "integer",
            "string"
          ]
        },
        "children_count": {
          "type": [
            "integer",
            "string"
          ]
        },
        "is_leaf": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "True",
                "False"
              ]
            }
          ]
        },
        "source_page_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "source_part": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "string",
              "pattern": "^0*[1-9][0-9]*$",
              "maxLength": 18
            },
            {
              "const": "المقدمة"
            }
          ]
        },
        "source_page_number": {
          "type": [
            "integer",
            "string"
          ]
        },
        "source_entry_number": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "path_ids": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        },
        "path_titles": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "lucene_title_key": {
          "type": "string",
          "pattern": "^622-[0-9]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "title_origin": {
            "const": "inferred"
          }
        }
      },
      "then": {
        "required": [
          "inference_evidence"
        ],
        "properties": {
          "inference_evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "inference_evidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parent_id": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "root_kind": {
            "type": "null"
          }
        }
      }
    }
  ]
}
